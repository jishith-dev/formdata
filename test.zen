import (FormData, MultipartFile) from "lib.zen"
fs.writeFile("hello.txt", "Hello from hello.txt\n")
fs.writeFile("notes.txt", "line one\nline two\nline three\n")

List<byte> photoBytes = []
loop (int n = 0, n < 300, n++) {
    photoBytes.push(Byte((n * 37 + 11) % 256))
}
fs.writeFileBytes("photo.bin", photoBytes)


FormData form
form.append("username", "jishith")
form.append("email", "jishith@example.com")
form.append("bio", "Builds things in Zen.\nSecond line.")
form.appendFile("doc", "hello.txt", "text/plain")
form.appendFile("notes", "notes.txt", "text/plain")
form.appendFile("photo", "photo.bin", "application/octet-stream")

screen("content type:")
screen(form.contentType())

screen("")
screen("username: " + form.get("username"))
screen("email: " + form.get("email"))
screen("bio: " + form.get("bio"))
screen("has doc: " + String(form.has("doc")))
screen("has missing: " + String(form.has("missing")))

MultipartFile doc = form.getFile("doc")
screen("")
screen("doc.name: " + doc.name)
screen("doc.filename: " + doc.filename)
screen("doc.contentType: " + doc.contentType)
screen("doc.size: " + String(doc.data.length))

FormData small
small.append("city", "Kochi")
small.append("age", "21")

List<byte> raw = small.encode()
string text = ""
loop (int i = 0, i < raw.length, i++) {
    text = text + Byte(raw[i])
}

screen("")
screen("encoded body of a small form:")
screen(text)

List<byte> body = form.encode()
screen("full form body size: " + String(body.length) + " bytes")

FormData reader
FormData parsed = reader.parse(body, form.contentType())

screen("")
screen("parsed username: " + parsed.get("username"))
screen("parsed email: " + parsed.get("email"))
screen("parsed bio: " + parsed.get("bio"))

MultipartFile pdoc = parsed.getFile("doc")
MultipartFile pnotes = parsed.getFile("notes")
MultipartFile pphoto = parsed.getFile("photo")

screen("parsed doc: " + pdoc.filename + " (" + pdoc.contentType + ", " + String(pdoc.data.length) + " bytes)")
screen("parsed notes: " + pnotes.filename + " (" + pnotes.contentType + ", " + String(pnotes.data.length) + " bytes)")
screen("parsed photo: " + pphoto.filename + " (" + pphoto.contentType + ", " + String(pphoto.data.length) + " bytes)")

pdoc.save("out_hello.txt")
pnotes.save("out_notes.txt")
pphoto.save("out_photo.bin")

List<byte> saved = fs.readFileBytes("out_notes.txt")
string savedText = ""
loop (int i = 0, i < saved.length, i++) {
    savedText = savedText + Byte(saved[i])
}

screen("")
screen("out_notes.txt contains:")
screen(savedText)

form.remove("email")
form.remove("notes")
screen("after remove, has email: " + String(form.has("email")))
screen("after remove, has notes: " + String(form.has("notes")))
screen("fields left: " + String(form.fields.length))
screen("files left: " + String(form.files.length))
